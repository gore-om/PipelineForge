pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }

  parameters {
    booleanParam(name: 'BOOTSTRAP_ECR', defaultValue: false, description: 'Create ECR repositories with Terraform before pushing images. Use for first deployment only.')
    booleanParam(name: 'APPLY_TERRAFORM', defaultValue: false, description: 'Apply the reviewed Terraform plan to AWS.')
    string(name: 'AWS_REGION', defaultValue: 'us-east-1', description: 'AWS region for ECR, ECS, ALB, S3, and optional RDS.')
    string(name: 'TF_WORKING_DIR', defaultValue: 'infra/aws-production', description: 'Terraform working directory.')
  }

  environment {
    IMAGE_TAG = "${env.BUILD_NUMBER}"
    FRONTEND_REPOSITORY = 'pipelineforge-production-frontend'
    API_REPOSITORY = 'pipelineforge-production-api'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Validate Application') {
      steps {
        sh 'node --version'
        sh 'npm ci'
        sh 'npm run build'
      }
    }

    stage('Terraform Static Checks') {
      steps {
        sh 'terraform -chdir=$TF_WORKING_DIR fmt -check'
        sh 'terraform -chdir=$TF_WORKING_DIR init -backend-config=backend.hcl'
        sh 'terraform -chdir=$TF_WORKING_DIR validate'
      }
    }

    stage('Bootstrap ECR') {
      when {
        expression { return params.BOOTSTRAP_ECR }
      }
      steps {
        input message: 'Create or reconcile ECR repositories before image push?', ok: 'Bootstrap ECR'
        sh '''
          terraform -chdir=$TF_WORKING_DIR apply -auto-approve \
            -target=aws_ecr_repository.frontend \
            -target=aws_ecr_lifecycle_policy.frontend \
            -target=aws_ecr_repository.api \
            -target=aws_ecr_lifecycle_policy.api
        '''
      }
    }

    stage('Build Images') {
      steps {
        sh 'docker build -t $FRONTEND_REPOSITORY:$IMAGE_TAG -f client/Dockerfile .'
        sh 'docker build -t $API_REPOSITORY:$IMAGE_TAG -f server/Dockerfile .'
      }
    }

    stage('Push Images To ECR') {
      steps {
        withCredentials([string(credentialsId: 'aws-account-id', variable: 'AWS_ACCOUNT_ID')]) {
          sh '''
            set -eu
            REGISTRY="$AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com"
            aws ecr get-login-password --region "$AWS_REGION" | docker login --username AWS --password-stdin "$REGISTRY"
            docker tag "$FRONTEND_REPOSITORY:$IMAGE_TAG" "$REGISTRY/$FRONTEND_REPOSITORY:$IMAGE_TAG"
            docker tag "$API_REPOSITORY:$IMAGE_TAG" "$REGISTRY/$API_REPOSITORY:$IMAGE_TAG"
            docker push "$REGISTRY/$FRONTEND_REPOSITORY:$IMAGE_TAG"
            docker push "$REGISTRY/$API_REPOSITORY:$IMAGE_TAG"
          '''
        }
      }
    }

    stage('Terraform Plan') {
      steps {
        sh '''
          terraform -chdir=$TF_WORKING_DIR plan \
            -var="aws_region=$AWS_REGION" \
            -var="frontend_image_tag=$IMAGE_TAG" \
            -var="api_image_tag=$IMAGE_TAG" \
            -out=tfplan
        '''
        archiveArtifacts artifacts: "${params.TF_WORKING_DIR}/tfplan", fingerprint: true
      }
    }

    stage('Approval Gate') {
      when {
        expression { return params.APPLY_TERRAFORM }
      }
      steps {
        input message: 'Apply the reviewed PipelineForge production Terraform plan?', ok: 'Apply'
      }
    }

    stage('Terraform Apply') {
      when {
        expression { return params.APPLY_TERRAFORM }
      }
      steps {
        sh 'terraform -chdir=$TF_WORKING_DIR apply -auto-approve tfplan'
      }
    }
  }

  post {
    always {
      sh 'docker logout || true'
    }
  }
}
